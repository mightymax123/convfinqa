# Host-level convenience aliases for the convfinqa project.
# Source this file in your shell to use:
#   source .aliases
#
# These are for interactive terminal use only. Do not call from scripts or agents.

alias format='docker compose exec app bash -ic "format"'
alias code-checks='docker compose exec app bash -ic "code-checks"'
alias run-tests='docker compose exec app bash -ic "run-tests"'
alias pipeline='docker compose exec app bash -ic "pipeline"'
alias all-checks='docker compose exec app bash -ic "all-checks"'
